<local:AccessibleDialogWindow x:Class="Pickets.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pickets"
        Title="Pickets dasturiga xush kelibsiz"
        Width="590" Height="610"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource DialogBackground}"
        Foreground="{DynamicResource DialogForeground}"
        FontFamily="Segoe UI">


    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="OnboardingContent" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,0">
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Pickets dasturiga xush kelibsiz" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource DialogMuted}" FontSize="14" TextWrapping="Wrap"
                       Text="Fayllarni ko‘chirmasdan ish stolingizni tartibga soling."/>
        </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="1   Ish stolini tayyorlang"
                           VerticalAlignment="Center"/>
                <ToggleButton x:Name="DesktopHelpButton"
                              Margin="8,0,0,0" Width="22" Height="22"
                              Padding="0" Content="?" FontSize="13" FontWeight="Bold"
                              Background="{DynamicResource DialogSurface}" Foreground="{DynamicResource DialogForeground}"
                              BorderBrush="{DynamicResource DialogBorder}" BorderThickness="1"
                              Cursor="Hand" ToolTip="Bu sozlamalar nima uchun kerak?"
                              AutomationProperties.Name="Ish stoli sozlamalari nima uchun kerak"/>
            </StackPanel>
            <Popup IsOpen="{Binding IsChecked, ElementName=DesktopHelpButton, Mode=TwoWay}"
                   PlacementTarget="{Binding ElementName=DesktopHelpButton}"
                   Placement="Bottom" HorizontalOffset="6" VerticalOffset="4"
                   AllowsTransparency="True" PopupAnimation="None" StaysOpen="False">
                <Border Width="410" MaxWidth="{Binding ActualWidth, ElementName=OnboardingContent}" Padding="15" CornerRadius="7"
                        Background="{DynamicResource DialogSurface}" BorderBrush="{DynamicResource DialogBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Pickets’ga bu nima uchun kerak" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DialogForeground}"/>
                        <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DialogMuted}"
                                   Text="Pickets fayllarni joyidan ko‘chirmaydi. U guruhga olingan belgining asl joyini eslab qoladi, ish stolidagi belgisini yashiradi va guruh ichida ko‘rsatadi."/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DialogMuted}"
                                   Text="«Belgilarni avtomatik tartiblash» va «Belgilarni to‘rga tekislash» yoqilgan bo‘lsa, Windows belgilar o‘rnini o‘zi o‘zgartiradi. Natijada guruhga olingan belgilar qayta paydo bo‘lishi yoki asl joyini yo‘qotishi mumkin. Ikkalasini o‘chirsangiz, Pickets belgilarni aniq avvalgi joyiga qaytara oladi."/>
                    </StackPanel>
                </Border>
            </Popup>
            <TextBlock Margin="28,3,0,8" Foreground="{DynamicResource DialogMuted}" TextWrapping="Wrap"
                       Text="Ish stolida o‘ng tugmani bosing, «Ko‘rinish» menyusini oching va ikkala sozlamani o‘chiring. Pickets ularni tekshiradi."/>
            <StackPanel Margin="28,0,0,0">
                <Border Margin="0,0,0,6" Padding="10,7" CornerRadius="5" Background="{DynamicResource DialogSurface}">
                    <DockPanel>
                        <Ellipse x:Name="AutoArrangeIndicator" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AutoArrangeStatus" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Border Margin="0,0,0,6" Padding="10,7" CornerRadius="5" Background="{DynamicResource DialogSurface}">
                    <DockPanel>
                        <Ellipse x:Name="SnapToGridIndicator" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SnapToGridStatus" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Button Content="Qayta tekshirish" HorizontalAlignment="Left" Padding="12,6" Click="Recheck_Click"/>
                <TextBlock x:Name="ReadinessHint" Margin="0,8,0,0" Foreground="{DynamicResource DialogMuted}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>

            <TextBlock Margin="0,20,0,0" FontSize="16" FontWeight="SemiBold" Text="2   Pickets’ni qulay ishga tushiring"/>
            <StackPanel Margin="28,3,0,0">
                <CheckBox x:Name="CreateShortcutCheck"><TextBlock Text="Ish stolida Pickets yorlig‘ini yaratish" TextWrapping="Wrap"/></CheckBox>
                <CheckBox x:Name="RunAtLoginCheck"><TextBlock Text="Tizimga kirganimda Pickets’ni ishga tushirish" TextWrapping="Wrap"/></CheckBox>
                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource DialogMuted}" FontSize="12" TextWrapping="Wrap"
                           Text="Maslahat: bu sozlamalarni yoqishdan oldin Pickets.exe faylini doimiy papkaga joylang."/>
            </StackPanel>

            <TextBlock Margin="0,20,0,0" FontSize="16" FontWeight="SemiBold" Text="3   Birinchi guruhni yarating"/>
            <StackPanel Margin="28,3,0,0">
                <TextBlock Foreground="{DynamicResource DialogMuted}" Text="Bo‘sh guruhdagi «Fayllarni qo‘shish» yoki «Papkalarni qo‘shish» tugmasini bosing. Keyin ham ⋯ → «Qo‘shish…» orqali qo‘sha olasiz. Asl fayllar joyida qoladi." TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource DialogMuted}" Text="Ish stoli belgilarini ochiq guruh ichiga, sarlavhasi ostiga tashlang. Guruhga olingan belgilar ish stolida yashiriladi. Tartiblash uchun ularni guruhlar orasida sudrang." TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource DialogMuted}" Text="Guruhni yig‘ish uchun sarlavhasini bosing; surish uchun sarlavhasini sudrang." TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource DialogMuted}" Text="Ctrl+Alt+D tugmalari Pickets’ni faollashtiradi; qayta bossangiz yashiradi. Tugmalarni o‘zgartirish yoki yordamni ochish uchun tizim panelidagi belgidan foydalaning." TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource DialogMuted}" Text="Delete faqat havolani guruhdan olib tashlaydi, asl faylni o‘chirmaydi. Belgini ish stoliga qaytarish uchun guruhdan tashqariga sudrang. Ctrl+Z — amalni bekor qilish; Ctrl+F — havolani topish." TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource DialogMuted}" Text="Tizim paneli → «Pickets’dan chiqish» guruhdagi ish stoli belgilarini qaytaradi. Alt+F4 esa faqat Pickets’ni yashiradi." TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource DialogMuted}" TextWrapping="Wrap"
                       Text="Ushbu qo‘llanmani tizim paneli menyusidan istalgan payt ochishingiz mumkin."/>
            <Button x:Name="GetStartedButton" HorizontalAlignment="Right" Content="Pickets’dan foydalanishni boshlash" IsDefault="True" IsEnabled="False" Click="GetStarted_Click"/>
        </StackPanel>
    </Grid>
</local:AccessibleDialogWindow>
