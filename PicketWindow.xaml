<Window x:Class="Pickets.PicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pickets"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MinWidth="160" MinHeight="32"
        Title="Guruh"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewDragEnter="Picket_DragOver"
        PreviewDragOver="Picket_DragOver"
        PreviewDragLeave="Picket_DragLeave"
        PreviewDrop="Picket_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}">
    <Window.Resources>
        <local:PicketCellWidthConverter x:Key="CellWidthConverter"/>
        <local:PicketLabelWidthConverter x:Key="LabelWidthConverter"/>
        <local:PicketTextHeightConverter x:Key="TextHeightConverter"/>
        <ContextMenu x:Key="ItemContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Ochish" Tag="Open" Click="ItemMenu_Open_Click"/>
            <MenuItem Header="Qayta tekshirish" Tag="Check" Click="ItemMenu_Check_Click"/>
            <MenuItem Header="Joyini ko‘rsatish…" Tag="Locate" Click="ItemMenu_Locate_Click"/>
            <MenuItem Header="Fayl joylashuvini ochish" Tag="Location" Click="ItemMenu_OpenLocation_Click"/>
            <MenuItem Header="Havolani ko‘chirish" Tag="MoveReferenceTo"/>
            <MenuItem Header="Katta belgi" Tag="LargeToggle" IsCheckable="True" Click="ItemMenu_ToggleLarge_Click"/>
            <Separator/>
            <MenuItem Header="Yuqoriga sarlavha qo‘shish…" Tag="InsertLabel" Click="ItemMenu_InsertLabelAbove_Click"/>
            <MenuItem Header="Sarlavhani o‘zgartirish…" Tag="RenameLabel" Visibility="Collapsed" Click="LabelMenu_Rename_Click"/>
            <MenuItem Header="Guruhdan olib tashlash" Tag="Remove" Click="ItemMenu_Remove_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="LabelContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Sarlavhani o‘zgartirish…" Click="LabelMenu_Rename_Click"/>
            <MenuItem Header="Sarlavhani olib tashlash" Click="LabelMenu_Remove_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="TitleContextMenu">
            <MenuItem Header="Qo‘shish…">
                <MenuItem Header="Fayllarni qo‘shish…" InputGestureText="Ctrl+O" Click="AddFiles_Click"/>
                <MenuItem Header="Papkalarni qo‘shish…" InputGestureText="Ctrl+Shift+O" Click="AddFolder_Click"/>
                <MenuItem Header="Sarlavha qo‘shish…" Click="TitleMenu_AddLabel_Click"/>
            </MenuItem>
            <MenuItem Header="Havolani topish…" InputGestureText="Ctrl+F" Click="FindReference_Click"/>
            <MenuItem Header="Bekor qilish" Tag="Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
            <Separator/>
            <MenuItem Header="Guruh nomini o‘zgartirish…" InputGestureText="F2" Click="TitleMenu_Rename_Click"/>
            <MenuItem Header="To‘plam" Tag="StackMenu">
                <MenuItem Header="Bir vaqtda bitta guruhni ochish" Tag="Accordion" IsCheckable="True" Click="TitleMenu_Accordion_Click"/>
                <MenuItem Header="Guruhni oldinga surish" Tag="Earlier" Click="MoveSectionEarlier_Click"/>
                <MenuItem Header="Guruhni orqaga surish" Tag="Later" Click="MoveSectionLater_Click"/>
                <MenuItem Header="Guruhni to‘plamdan ajratish" Click="UnlinkBtn_Click"/>
                <Separator/>
                <MenuItem Header="Oldingi sahifa" Tag="PreviousPage" InputGestureText="Ctrl+PageUp" Click="PreviousStackPage_Click"/>
                <MenuItem Header="Keyingi sahifa" Tag="NextPage" InputGestureText="Ctrl+PageDown" Click="NextStackPage_Click"/>
            </MenuItem>
            <MenuItem Header="Ko‘rinish">
                <MenuItem Header="Balandlik">
                    <MenuItem Header="Avtomatik (ikki qatorgacha)" Tag="AutoHeight" IsCheckable="True" Click="AutoHeight_Click"/>
                    <MenuItem Header="Qo‘lda" Tag="ManualHeight" IsCheckable="True" Click="ManualHeight_Click"/>
                </MenuItem>
                <MenuItem Header="Rang" Tag="ColorMenu">
                <MenuItem Header="Chinni" Tag="porcelain" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#A79F94" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#DFC9A9" Offset="0.5"/><GradientStop Color="#F1E4CE" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Qumtosh" Tag="sandstone" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#A08055" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E7B974" Offset="0.5"/><GradientStop Color="#F3D39F" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Mavrak" Tag="sage" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#7B9680" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#AACD9F" Offset="0.5"/><GradientStop Color="#C9E2BF" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Okean" Tag="ocean" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#6E91A4" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#99C4DA" Offset="0.5"/><GradientStop Color="#BFDDEB" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Lavanda" Tag="lavender" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#8E7BA5" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#C5ABE0" Offset="0.5"/><GradientStop Color="#DDCBEE" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Atirgul" Tag="rose" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#A67B84" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#DEA5B7" Offset="0.5"/><GradientStop Color="#F0C6D1" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Tun" Tag="midnight" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#496B91" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1D3555" Offset="0.5"/><GradientStop Color="#131B29" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Grafit" Tag="graphite" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#58616E" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#292E36" Offset="0.5"/><GradientStop Color="#181B20" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Qora" Tag="black" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#555555"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#101010" Offset="0.5"/><GradientStop Color="#000000" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Oq" Tag="white" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#B3B3B3"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F2F2F2" Offset="0.5"/><GradientStop Color="#FFFFFF" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Joriy ko‘rinishni barcha guruhlarga qo‘llash" Click="TitleMenu_ApplyColorToAll_Click"/>
                </MenuItem>
                <MenuItem Header="Shaffoflik" Tag="TransparencyMenu">
                <MenuItem Header="To‘liq (100%)" Tag="solid"  IsCheckable="True" Click="TitleMenu_SetTransparency_Click"/>
                <MenuItem Header="Yengil (65%)"  Tag="light"  IsCheckable="True" Click="TitleMenu_SetTransparency_Click"/>
                <MenuItem Header="O‘rtacha (40%)" Tag="medium" IsCheckable="True" Click="TitleMenu_SetTransparency_Click"/>
                <MenuItem Header="Kuchli (20%)"  Tag="heavy"  IsCheckable="True" Click="TitleMenu_SetTransparency_Click"/>
                <Separator/>
                <MenuItem Tag="custom" StaysOpenOnClick="True" IsCheckable="True">
                    <MenuItem.Header>
                        <StackPanel Orientation="Vertical" Width="200" Margin="0,2">
                            <TextBlock Tag="CustomLabel" Text="Boshqa: 50%" Margin="0,0,0,2"/>
                            <Slider Tag="CustomSlider"
                                    Minimum="0" Maximum="100" Value="50" AutomationProperties.Name="Guruh shaffofligi"
                                    Width="190" TickFrequency="5"
                                    ValueChanged="TransparencyCustomSlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                </MenuItem>
                <MenuItem Header="Orqa fonni xiralashtirish" Tag="BlurToggle" IsCheckable="True" Click="TitleMenu_ToggleBlur_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Yangi guruh" InputGestureText="Ctrl+N" Click="TitleMenu_NewPicket_Click"/>
            <MenuItem Header="Ushbu guruhni o‘chirish…" Click="TitleMenu_DeletePicket_Click"/>
            <MenuItem Header="Sozlamalar va yordam">
                <MenuItem Header="Barcha havolalarni tekshirish" Click="TitleMenu_CleanMissing_Click"/>
                <MenuItem Header="Faollashtirish tugmalarini o‘zgartirish…" Click="ShortcutSettings_Click"/>
                <MenuItem Header="Tizimga kirganda ishga tushirish" Tag="LaunchAtLogin" IsCheckable="True" Click="TitleMenu_ToggleLaunchAtLogin_Click"/>
                <Separator/>
                <MenuItem Header="Klaviatura bo‘yicha yordam…" InputGestureText="F1" Click="KeyboardHelp_Click"/>
                <MenuItem Header="Pickets haqida…" Click="TitleMenu_About_Click"/>
                <MenuItem Header="Qo‘shimcha amallar">
                    <MenuItem Header="Barcha belgilarni tiklab chiqish…" Click="TitleMenu_RestoreAll_Click"/>
                    <MenuItem Header="Belgilarni yashirin qoldirib chiqish" Click="TitleMenu_ExitHidden_Click"/>
                </MenuItem>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Pickets’ni yashirish" Click="TitleMenu_HideAll_Click"/>
            <MenuItem Header="Pickets’dan chiqish…" Click="TitleMenu_Quit_Click"/>
        </ContextMenu>

        <!-- Tooltips need a solid background; default semi-transparent styling over a blurred picket
             becomes unreadable against wallpaper. Dark pill + light text works on any color scheme. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PicketTitleForeground}"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Background" Value="{DynamicResource PicketControlHoverBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource PicketFocusBorder}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="OuterShell"
                CornerRadius="10"
                Background="#C8EDEDED"
                BorderBrush="#70999999"
                BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Border x:Name="TitleShell"
                        DockPanel.Dock="Top"
                        Background="#D0DDDDDD"
                        Height="30"
                        CornerRadius="10,10,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        MouseMove="TitleBar_MouseMove"
                        MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                        LostMouseCapture="TitleBar_LostMouseCapture"
                        ContextMenu="{StaticResource TitleContextMenu}"
                        ContextMenuOpening="TitleBar_ContextMenuOpening">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:PicketHeaderButton x:Name="TitleToggle" Grid.Column="0" Style="{StaticResource HeaderButton}"
                            ContextMenu="{StaticResource TitleContextMenu}" ContextMenuOpening="TitleBar_ContextMenuOpening"
                            HorizontalContentAlignment="Left" Padding="8,0,2,0"
                            PreviewMouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Click="TitleToggle_Click"
                            AutomationProperties.HelpText="Guruhni ochish yoki yig‘ish. To‘plamni surish uchun sarlavhani torting. F2 — nomini o‘zgartirish, F1 — yordam.">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                      IsHitTestVisible="False">
                                    <Path x:Name="ExpansionChevron" Data="M 4,2 L 8,6 L 4,10"
                                          Stroke="{DynamicResource PicketTitleForeground}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="ChevronRotation" Angle="90"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                                <TextBlock x:Name="TitleText" Text="Guruh" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </local:PicketHeaderButton>
                        <TextBox x:Name="TitleEditBox" Grid.Column="0" Visibility="Collapsed"
                            VerticalAlignment="Center" Margin="10,1,4,1"
                            AutomationProperties.Name="Guruh nomi"
                            Background="{DynamicResource PicketEditorBackground}"
                            Foreground="{DynamicResource PicketTitleForeground}"
                            BorderBrush="{DynamicResource PicketEditorBorder}"
                            KeyDown="TitleEditBox_KeyDown" LostFocus="TitleEditBox_LostFocus"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Button x:Name="UnlinkBtn" Width="24" Height="26" Style="{StaticResource HeaderButton}" Content="↗"
                                AutomationProperties.Name="Guruhni ajratish" ToolTip="Ushbu guruhni to‘plamdan ajratish" Visibility="Collapsed" Click="UnlinkBtn_Click"/>
                            <Button x:Name="PreviousPageButton" Width="24" Height="26" Style="{StaticResource HeaderButton}" Content="‹" Visibility="Collapsed"
                                AutomationProperties.Name="To‘plamning oldingi sahifasi" Click="PreviousStackPage_Click"/>
                            <Button x:Name="NextPageButton" Width="24" Height="26" Style="{StaticResource HeaderButton}" Content="›" Visibility="Collapsed"
                                AutomationProperties.Name="To‘plamning keyingi sahifasi" Click="NextStackPage_Click"/>
                            <Button x:Name="MenuButton" Width="26" Height="26" Style="{StaticResource HeaderButton}" Content="⋯"
                                ContextMenu="{StaticResource TitleContextMenu}" ContextMenuOpening="TitleBar_ContextMenuOpening"
                                AutomationProperties.Name="Guruh menyusi" ToolTip="Guruh menyusi: fayl qo‘shish, ko‘rinishni sozlash va guruh yaratish" Click="MenuButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="SelectionActions" DockPanel.Dock="Top" Visibility="Collapsed" Padding="5,3"
                        Background="{Binding Background, ElementName=TitleShell}" SizeChanged="SelectionActions_SizeChanged"
                        TextElement.Foreground="{DynamicResource PicketItemForeground}">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SelectionCount" VerticalAlignment="Center" Margin="3,0,10,0" AutomationProperties.LiveSetting="Polite"/>
                        <Button Content="Ko‘chirish" Padding="6,3" Style="{StaticResource HeaderButton}" Click="SelectionMove_Click" AutomationProperties.Name="Tanlanganlarni ko‘chirish"/>
                        <Button Content="O‘lcham" Padding="6,3" Style="{StaticResource HeaderButton}" Click="SelectionSize_Click" AutomationProperties.Name="Tanlangan belgilar o‘lchami"/>
                        <Button Content="Olib tashlash" Padding="6,3" Style="{StaticResource HeaderButton}" Click="SelectionRemove_Click" AutomationProperties.Name="Tanlangan havolalarni olib tashlash"/>
                        <Button Content="Tozalash" Padding="6,3" Style="{StaticResource HeaderButton}" Click="SelectionClear_Click" AutomationProperties.Name="Tanlovni tozalash"/>
                    </WrapPanel>
                </Border>
                <Grid x:Name="BodyArea" ClipToBounds="True"
                      PreviewMouseLeftButtonDown="Selection_MouseDown" PreviewMouseMove="Selection_MouseMove"
                      PreviewMouseLeftButtonUp="Selection_MouseUp" LostMouseCapture="Selection_LostCapture">
                <ScrollViewer x:Name="BodyScroll"
                              VerticalScrollBarVisibility="Auto"
                              Padding="4"
                              AllowDrop="True"
                              Drop="ItemsHost_Drop"
                              Background="Transparent">
                    <Grid>
                    <ListBox x:Name="ItemsHost" SelectionMode="Extended" BorderThickness="0" Padding="0" Background="Transparent" SelectionChanged="Items_SelectionChanged"
                        AutomationProperties.Name="Guruhdagi havolalar" KeyboardNavigation.TabNavigation="Once"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding ReferenceHelp}"/>
                                <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PicketItemForeground}"/>
                                <Setter Property="VerticalAlignment" Value="Top"/>
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_MouseDown"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="Item_RightMouseDown"/>
                                <EventSetter Event="MouseMove" Handler="Item_MouseMove"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="Item_MouseLeftButtonUp"/>
                                <EventSetter Event="ContextMenuOpening" Handler="Item_ContextMenuOpening"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Cell" Margin="1" Padding="1" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Cell" Property="Background" Value="{DynamicResource PicketControlHoverBrush}"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource PicketSelectionBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PicketSelectionForeground}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource PicketFocusBorder}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.Resources>
                            <DataTemplate x:Key="FileItemTemplate">
                                <StackPanel ToolTip="{Binding ReferenceHelp}"
                                    TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                    <StackPanel.Width>
                                        <MultiBinding Converter="{StaticResource CellWidthConverter}">
                                            <Binding Path="CellWidth"/>
                                            <Binding Path="FontSize" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                                        </MultiBinding>
                                    </StackPanel.Width>
                                    <Grid Width="{Binding IconSize}" Height="{Binding IconSize}" Margin="0,4,0,4">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding Icon}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                        LineStackingStrategy="BlockLineHeight"
                                        LineHeight="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource TextHeightConverter}}"
                                        MaxHeight="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource TextHeightConverter}, ConverterParameter=2}"/>
                                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="1,2,1,0"
                                        LineStackingStrategy="BlockLineHeight"
                                        LineHeight="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource TextHeightConverter}}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:Key="LabelItemTemplate">
                                <TextBlock Text="{Binding LabelText}" FontWeight="SemiBold" Padding="6,5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding LabelText}"
                                    MaxHeight="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource TextHeightConverter}, ConverterParameter=Label}"
                                    LineStackingStrategy="BlockLineHeight"
                                    LineHeight="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource TextHeightConverter}}"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}, Converter={StaticResource LabelWidthConverter}}"/>
                            </DataTemplate>
                            <local:PicketItemTemplateSelector x:Key="ItemSelector" FileTemplate="{StaticResource FileItemTemplate}" LabelTemplate="{StaticResource LabelItemTemplate}"/>
                        </ListBox.Resources>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><local:PicketItemsPanel RowsMeasured="ContentRowsMeasured"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplateSelector><StaticResource ResourceKey="ItemSelector"/></ListBox.ItemTemplateSelector>
                    </ListBox>
                    <StackPanel x:Name="EmptyState" Margin="14,18" HorizontalAlignment="Stretch" TextElement.Foreground="{DynamicResource PicketItemForeground}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ItemsHost}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Fayllarni shu yerga tashlang" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                        <TextBlock Text="Fayllaringiz o‘z joyida qoladi." TextWrapping="Wrap" Margin="0,5,0,12"/>
                        <WrapPanel>
                            <Button Content="Fayllarni qo‘shish…" Click="AddFiles_Click" Padding="8,5" Margin="0,0,6,6" Style="{StaticResource HeaderButton}" Background="{DynamicResource PicketSectionBackground}"/>
                            <Button Content="Papkalarni qo‘shish…" Click="AddFolder_Click" Padding="8,5" Margin="0,0,0,6" Style="{StaticResource HeaderButton}" Background="{DynamicResource PicketSectionBackground}"/>
                        </WrapPanel>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="SelectionBox" Visibility="Collapsed" Stroke="{DynamicResource PicketFocusBorder}"
                               StrokeThickness="1" Fill="{DynamicResource PicketSelectionBrush}" Opacity="0.55"/>
                </Canvas>
                <Border x:Name="DropTargetOutline" IsHitTestVisible="False" Visibility="Collapsed" BorderThickness="2"
                        BorderBrush="{DynamicResource PicketFocusBorder}" CornerRadius="3" Margin="2"/>
                </Grid>
            </DockPanel>
        </Border>

        <TextBlock x:Name="ResizeHint" Text="◢" FontSize="12" Foreground="{DynamicResource PicketFocusBorder}"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,0" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Opacity" Value="0"/><Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Opacity" Value="0.7"/></DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Opacity" Value="0.7"/></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <!-- Invisible resize hit areas sit over the visible hover/focus hint. -->
        <Thumb x:Name="ResizeRight"
               HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Width="6" Cursor="SizeWE" Opacity="0"
               Focusable="False"
               DragStarted="Resize_DragStarted" DragCompleted="Resize_DragCompleted"
               DragDelta="ResizeRight_DragDelta"/>
        <Thumb x:Name="ResizeBottom"
               HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
               Height="6" Cursor="SizeNS" Opacity="0"
               DragStarted="Resize_DragStarted" DragCompleted="Resize_DragCompleted"
               DragDelta="ResizeBottom_DragDelta"/>
        <Thumb x:Name="ResizeBottomRight"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Width="14" Height="14" Cursor="SizeNWSE" Opacity="0"
               DragStarted="Resize_DragStarted" DragCompleted="Resize_DragCompleted"
               DragDelta="ResizeBottomRight_DragDelta"/>
    </Grid>
</Window>
